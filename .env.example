# ================================================
# 密钥配置文件：把本文件复制一份改名为 .env，然后把 Key 填到等号后面
# （.env 文件只在你自己电脑上，不会被上传，不要把 Key 发给别人）
# ================================================

# ---- 阿里云百炼（视觉识别 + 向量检索）----
# 获取地址：https://bailian.console.aliyun.com/  左侧「API-KEY」
VISION_API_KEY=请粘贴你的百炼API_KEY
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max
EMBED_MODEL=text-embedding-v3

# ---- DeepSeek（出题与解析）----
# 获取地址：https://platform.deepseek.com/  左侧「API keys」
LLM_API_KEY=请粘贴你的DeepSeek_API_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
